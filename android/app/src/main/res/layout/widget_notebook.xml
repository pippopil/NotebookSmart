<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📓 NotebookSmart"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒 Покупки"
            android:textColor="#065F46"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle / Summary -->
    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Список покупок актуален"
        android:textColor="#57534E"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <!-- Item lines -->
    <TextView
        android:id="@+id/widget_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Молоко 3.2% 1 л"
        android:textColor="#1C1917"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Хлеб бородинский"
        android:textColor="#1C1917"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Сыр твёрдый 200 г"
        android:textColor="#1C1917"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ еще товары в списке..."
        android:textColor="#A8A29E"
        android:textSize="10sp"
        android:textStyle="italic" />

</LinearLayout>
